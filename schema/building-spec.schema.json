  "Link": {
   "additionalProperties": false,
   "description": "A straight glazed or masonry wall between two named points, such as\n``pav_tl.v0`` (a pavilion vertex), ``pav_tl.arc0.start`` (an arc end) or a\ncontrol point id.",
   "properties": {
    "id": {
     "pattern": "^[a-z][a-z0-9_]*$",
     "title": "Id",
     "type": "string"
    },
    "pattern": {
     "const": "link",
     "title": "Pattern",
     "type": "string"
    },
    "kind": {
     "enum": [
      "glazed",
      "masonry"
     ],
     "title": "Kind",
     "type": "string"
    },
    "start": {
     "title": "Start",
     "type": "string"
    },
    "end": {
     "title": "End",
     "type": "string"
    },
    "floor": {
     "title": "Floor",
     "type": "string"
    },
    "type": {
     "description": "door panel type for glazed links, wall type for masonry",
     "title": "Type",
     "type": "string"
    },
    "header": {
     "anyOf": [
      {
       "$ref": "#/$defs/HeaderSpec"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "top": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "level id of the top of a masonry link",
     "title": "Top"
    },
    "inset": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "format": "fraction",
       "type": "string"
      }
     ],
     "default": "6",
     "title": "Inset"
    },
    "lettered": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "format": "fraction",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "length written on the sheet, for cross-checking",
     "title": "Lettered"
    },
    "src": {
     "$ref": "#/$defs/Source"
    }
   },
   "required": [
    "id",
    "pattern",
    "kind",
    "start",
    "end",
    "floor",
    "type",
    "src"
   ],
   "title": "Link",
   "type": "object"
  },

{
 "$defs": {
  "Building": {
   "additionalProperties": false,
   "properties": {
    "id": {
     "title": "Id",
     "type": "string"
    },
    "code": {
     "description": "Short code used in asset names",
     "pattern": "^[A-Z][A-Za-z0-9]{0,11}$",
     "title": "Code",
     "type": "string"
    },
    "name": {
     "title": "Name",
     "type": "string"
    }
   },
   "required": [
    "id",
    "code",
    "name"
   ],
   "title": "Building",
   "type": "object"
  },
  "Chain": {
   "additionalProperties": false,
   "description": "A dimension string: its parts must sum to its overall.",
   "properties": {
    "sheet": {
     "title": "Sheet",
     "type": "string"
    },
    "where": {
     "title": "Where",
     "type": "string"
    },
    "parts": {
     "items": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "format": "fraction",
        "type": "string"
       }
      ]
     },
     "minItems": 2,
     "title": "Parts",
     "type": "array"
    },
    "overall": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "format": "fraction",
       "type": "string"
      }
     ],
     "title": "Overall"
    },
    "tolerance": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "format": "fraction",
       "type": "string"
      }
     ],
     "default": "1/16",
     "title": "Tolerance"
    },
    "note": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Note"
    }
   },
   "required": [
    "sheet",
    "where",
    "parts",
    "overall"
   ],
   "title": "Chain",
   "type": "object"
  },
  "Checks": {
   "additionalProperties": false,
   "properties": {
    "chains": {
     "default": [],
     "items": {
      "$ref": "#/$defs/Chain"
     },
     "title": "Chains",
     "type": "array"
    },
    "rules": {
     "default": [],
     "items": {
      "$ref": "#/$defs/RuleCheck"
     },
     "title": "Rules",
     "type": "array"
    }
   },
   "title": "Checks",
   "type": "object"
  },
  "ComponentType": {
   "additionalProperties": false,
   "properties": {
    "kind": {
     "enum": [
      "column",
      "beam",
      "panel",
      "slab",
      "wall",
      "roof",
      "ring",
      "dome",
      "plate"
     ],
     "title": "Kind",
     "type": "string"
    },
    "material": {
     "title": "Material",
     "type": "string"
    },
    "profile": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Profile"
    },
    "height": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "format": "fraction",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Height"
    },
    "section": {
     "anyOf": [
      {
       "maxItems": 2,
       "minItems": 2,
       "prefixItems": [
        {
         "anyOf": [
          {
           "type": "number"
          },
          {
           "format": "fraction",
           "type": "string"
          }
         ]
        },
        {
         "anyOf": [
          {
           "type": "number"
          },
          {
           "format": "fraction",
           "type": "string"
          }
         ]
        }
       ],
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "width, depth",
     "title": "Section"
    },
    "thickness": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "format": "fraction",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Thickness"
    },
    "facing": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "format": "fraction",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "walls: masonry facing outside the dimensioned face",
     "title": "Facing"
    },
    "rise": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "format": "fraction",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Rise"
    },
    "collision": {
     "default": true,
     "title": "Collision",
     "type": "boolean"
    },
    "src": {
     "$ref": "#/$defs/Source"
    }
   },
   "required": [
    "kind",
    "material",
    "src"
   ],
   "title": "ComponentType",
   "type": "object"
  },
  "ConicalRoofSpec": {
   "additionalProperties": false,
   "properties": {
    "type": {
     "title": "Type",
     "type": "string"
    },
    "eave_overhang": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "format": "fraction",
       "type": "string"
      }
     ],
     "title": "Eave Overhang"
    },
    "span": {
     "default": "rest",
     "description": "cover every non-glazed angle, or only the stone arcs",
     "enum": [
      "rest",
      "arcs"
     ],
     "title": "Span",
     "type": "string"
    },
    "max_step": {
     "default": 7.5,
     "description": "largest angle between roof sections",
     "title": "Max Step",
     "type": "number"
    },
    "nominal_pitch": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "pitch stated in a general note, for cross-checking",
     "title": "Nominal Pitch"
    },
    "src": {
     "$ref": "#/$defs/Source"
    }
   },
   "required": [
    "type",
    "eave_overhang",
    "src"
   ],
   "title": "ConicalRoofSpec",
   "type": "object"
  },
  "ControlPoint": {
   "additionalProperties": false,
   "properties": {
    "at": {
     "maxItems": 2,
     "minItems": 2,
